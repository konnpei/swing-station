# このファイルをコピーして .env.local という名前で保存し、値を埋めてください。
# .env.local はGit管理対象外なので、ここに実際のキーを書いても安全です。
#
# cp .env.local.example .env.local

# Supabaseダッシュボード → Project Settings → API で確認できます
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only: never prefix these with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=
SHOP_PASSWORD=
ALEXA_SKILL_ID=
ALEXA_ALLOWED_USER_IDS=
